# Bearer between the gateway and the Kokoro engine (the engine's API_KEYS).
KOKORO_FASTAPI_API_KEY=

# Bearer required by the gateway itself. Leave empty to disable auth (LAN only).
KOKORO_TONE_API_KEY=
# Optional comma-separated list, merged with the singular key above.
KOKORO_TONE_API_KEYS=

# Released gateway image, used by `make up-image` and compose.prod.yml.
# Pin an exact release (e.g. 2026.11.2) for reproducibility; latest floats.
KOKORO_TONE_VERSION=latest
# Override the registry/repository if you mirror the image.
KOKORO_TONE_IMAGE=ghcr.io/marcubus/kokoro-tone

# Engine seam. Point at OpenRouter to fall back to the hosted engine (see README).
UPSTREAM_BASE_URL=http://kokoro:8880/v1
# Leave empty to reuse KOKORO_FASTAPI_API_KEY; set only for the OpenRouter fallback.
UPSTREAM_API_KEY=
UPSTREAM_MODEL=kokoro

# Log level for the gateway: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# OpenTelemetry metrics are disabled by default. To enable them, uncomment the
# OTel environment and `networks` entries in compose.yml, and create the shared
# `metrics` network first.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kokoro-tone
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=homelab

# Voice used when the request does not name one.
DEFAULT_VOICE=af_heart

# Mastering target. Podcast default -16 LUFS; clamped to -30..-12.
LOUDNESS_LUFS=-16

# Static per-voice casting gain (all measured voices). false leaves raw levels.
VOICE_LEVELLING=true

# Request bounds. Defaults mirror src/kokoro_tone/limits.py.
MIN_RATE=0.75
MAX_RATE=1.3
MIN_PITCH=-3.0
MAX_PITCH=3.0
MIN_SPEED=0.25
MAX_SPEED=4.0
MAX_PAUSE_MS=30000
MAX_TOTAL_PAUSE_MS=60000
MAX_TURNS=100
MAX_ALIASES=64
MAX_INSTRUCTIONS_CHARS=2000
MAX_INPUT_CHARS=4096
MAX_VOICE_CHARS=200
MAX_BODY_BYTES=1048576
SEGMENT_CHARS=1000
TURN_GAP_MS=350

# Lexicon and normalisation. Only the deployment choices; the rest is built in.
PRONUNCIATION_LEXICON=/etc/kokoro-tone/lexicon.json
# Optional user overlay, composed in memory over the defaults. Missing is fine.
PRONUNCIATION_OVERRIDES=/etc/kokoro-tone/custom.json
LOCALE=en-AU
NORMALISE_DEFAULT=false
