# Bearer between the gateway and the Kokoro engine (the engine's API_KEYS).
KOKORO_FASTAPI_API_KEY=

# Bearer required by the gateway itself. Leave empty to disable auth (LAN only).
KOKORO_TONE_API_KEY=
# Optional comma-separated list, merged with the singular key above.
KOKORO_TONE_API_KEYS=

# Engine seam. Point at OpenRouter to fall back to the hosted engine (see README).
UPSTREAM_BASE_URL=http://kokoro:8880/v1
# Leave empty to reuse KOKORO_FASTAPI_API_KEY; set only for the OpenRouter fallback.
UPSTREAM_API_KEY=
UPSTREAM_MODEL=kokoro

# Voice used when a request does not name one.
DEFAULT_VOICE=af_heart

# Mastering target. Podcast default -16 LUFS; clamped to -30..-12.
LOUDNESS_LUFS=-16

# Request bounds. Defaults mirror src/kokoro_tone/limits.py.
MIN_RATE=0.75
MAX_RATE=1.3
MIN_PITCH=-3.0
MAX_PITCH=3.0
MIN_SPEED=0.25
MAX_SPEED=4.0
MAX_PAUSE_MS=30000
MAX_TOTAL_PAUSE_MS=60000
MAX_TURNS=100
MAX_ALIASES=64
MAX_INSTRUCTIONS_CHARS=2000
MAX_INPUT_CHARS=4096
MAX_VOICE_CHARS=200
MAX_BODY_BYTES=1048576
SEGMENT_CHARS=1000
TURN_GAP_MS=350
