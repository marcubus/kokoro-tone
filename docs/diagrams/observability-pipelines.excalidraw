      "id": "title",
      "x": 80, "y": 40, "width": 1640, "height": 40,
      "text": "Three signals, three paths: metrics go through a collector, logs stay logfmt",
      "originalText": "Three signals, three paths: metrics go through a collector, logs stay logfmt",
      "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
